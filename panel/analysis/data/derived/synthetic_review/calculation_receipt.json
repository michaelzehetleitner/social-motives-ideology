        "nu_fixed": 4,
        "sigma_scale_prior_sd": 0.707106781186548
      }
    },
    "inference": {
      "prereg": "AP10",
      "credible_rule": "95% CrI under the primary prior excludes zero",
      "confirmation_rule": "credible AND posterior median sign == predicted sign",
      "disconfirmation_rule": "credible AND sign opposite to prediction",
