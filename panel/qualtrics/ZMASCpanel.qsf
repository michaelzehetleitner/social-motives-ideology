":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"true","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"NoText","PartialData":"+2 weeks","ValidationMessage":null,"PreviousButton":" \u2190 ","NextButton":" \u2192 ","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"","SkinType":"templated","Skin":{"brandingId":null,"templateId":"*modern","overrides":{"answerText":{"size":"14px"},"questionText":{"size":"20px"}}},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"Yes","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":"Continue","BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"DE":[]},"QuestionsPerPage":"","Autofocus":"false","Autoadvance":"false","AutoadvanceHideButton":"false","AutoadvancePages":"false","PageTransition":"none","HiddenLanguages":[],"CustomLanguages":[],"SurveyCreationDate":"2026-04-15 00:16:29","ProtectSelectionIds":true}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID100","SecondaryAttribute":"Teilnahmeinformationen An dieser Studie k\u00f6nnen Personen ab 18 Jahren teilnehmen. \u00a0 Die Teilnahme..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><u><strong>Teilnahmeinformationen</strong></u></div>\n\n<p>An dieser Studie k&ouml;nnen Personen <strong>ab 18 Jahren</strong> teilnehmen.<br />\n&nbsp;</p>\n\n<p>Die Teilnahme an der Studie ist <strong>freiwillig </strong>und kann jederzeit durch Schlie&szlig;en des Browserfensters beendet werden.</p>\n\n<p><br />\nWir erheben nur die f&uuml;r die Forschung notwendigen Angaben. Das Forschungsteam erhebt im Rahmen der Studie <strong>keine direkten Identifikationsdaten</strong> wie Namen, E-Mail-Adressen, IP-Adressen oder Geodaten. Wenn Sie &uuml;ber Bilendi an der Studie teilnehmen, wird vor&uuml;bergehend ein Teilnahmecode verarbeitet; n&auml;here Informationen hierzu finden Sie im Abschnitt &bdquo;Teilnahme &uuml;ber Bilendi&ldquo;.</p>\n\n<p><br />\nDie Forschungsdaten werden f&uuml;r wissenschaftliche Zwecke gespeichert und ausgewertet. In wissenschaftlichen Ver&ouml;ffentlichungen (z. B. Fachaufs&auml;tzen, Vortr&auml;gen) werden <strong>ausschlie&szlig;lich zusammengefasste Ergebnisse berichtet,</strong> aus denen einzelne Personen nicht erkennbar sind. Zus&auml;tzlich wird der <strong>Forschungsdatensatz nach Abschluss der Datenerhebung f&uuml;r die wissenschaftliche Nachnutzung bereitgestellt;</strong> Einzelheiten dazu finden Sie im Abschnitt &bdquo;Wissenschaftliche Nachnutzung des Forschungsdatensatzes&ldquo;.</p>\n\n<p><br />\n<strong>Projektverantwortlicher</strong> ist Prof. Dr. Michael Zehetleitner, KU Eichst&auml;tt-Ingolstadt (E-Mail: michael.zehetleitner@ku.de).</p>\n\n<p><br />\nBei <strong>R&uuml;ckfragen</strong> wenden Sie sich gerne an den Projektverantwortlichen. Wenn Sie uns au&szlig;erhalb der Studie f&uuml;r R&uuml;ckfragen Ihre E-Mail-Adresse mitteilen, wird diese ausschlie&szlig;lich zur Beantwortung Ihrer Anfrage genutzt und danach gel&ouml;scht. Diese E-Mail-Adresse wird nicht mit Ihren Studiendaten zusammengef&uuml;hrt.</p>","DefaultChoices":false,"DataExportTag":"info_teilnahme_1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Teilnahmeinformationen An dieser Studie k\u00f6nnen Personen ab 18 Jahren teilnehmen. \u00a0 Die Teilnahme...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID100","QuestionText_Unsafe":"<div><u><strong>Teilnahmeinformationen</strong></u></div>\n<p>An dieser Studie k\u00f6nnen Personen ab 18 Jahren teilnehmen.</p>\n<p>Die Teilnahme an der Studie ist freiwillig und kann jederzeit durch Schlie\u00dfen des Browserfensters beendet werden.</p>\n<p>Wir erheben nur die f\u00fcr die Forschung notwendigen Angaben. Das Forschungsteam erhebt im Rahmen der Studie keine direkten Identifikationsdaten wie Namen, E-Mail-Adressen, IP-Adressen oder Geodaten. Wenn Sie \u00fcber Bilendi an der Studie teilnehmen, wird vor\u00fcbergehend ein Teilnahmecode verarbeitet; n\u00e4here Informationen hierzu finden Sie im Abschnitt \u201eTeilnahme \u00fcber Bilendi\u201c.</p>\n<p>Die Forschungsdaten werden f\u00fcr wissenschaftliche Zwecke gespeichert und ausgewertet. In wissenschaftlichen Ver\u00f6ffentlichungen (z. B. Fachaufs\u00e4tzen, Vortr\u00e4gen) werden ausschlie\u00dflich zusammengefasste Ergebnisse berichtet, aus denen einzelne Personen nicht erkennbar sind. Zus\u00e4tzlich wird der Forschungsdatensatz nach Abschluss der Datenerhebung f\u00fcr die wissenschaftliche Nachnutzung bereitgestellt; Einzelheiten dazu finden Sie im Abschnitt \u201eWissenschaftliche Nachnutzung des Forschungsdatensatzes\u201c.</p>\n<p>Projektverantwortlicher ist Prof. Dr. Michael Zehetleitner, KU Eichst\u00e4tt-Ingolstadt (E-Mail: michael.zehetleitner@ku.de).</p>\n<p>Bei R\u00fcckfragen wenden Sie sich gerne an den Projektverantwortlichen. Wenn Sie uns au\u00dferhalb der Studie f\u00fcr R\u00fcckfragen Ihre E-Mail-Adresse mitteilen, wird diese ausschlie\u00dflich zur Beantwortung Ihrer Anfrage genutzt und danach gel\u00f6scht. Diese E-Mail-Adresse wird nicht mit Ihren Studiendaten zusammengef\u00fchrt.</p>"}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID102","SecondaryAttribute":"Wenn Sie weitere Informationen zum Umgang mit personenbezogenen Daten anzeigen m\u00f6chten, w\u00e4hlen Sie","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>Wenn Sie die detaillierten Informationen zum Umgang mit personenbezogenen Daten anzeigen m\u00f6chten, w\u00e4hlen Sie bitte <strong>Anzeigen</strong>.</p>","DefaultChoices":false,"DataExportTag":"info_teilnahme_2","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Wenn Sie weitere Informationen zum Umgang mit personenbezogenen Daten anzeigen m\u00f6chten, w\u00e4hlen Sie bitte Anzeigen.","Choices":{"1":{"Display":"Anzeigen"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"QuestionID":"QID102"}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID105","SecondaryAttribute":"Vielen Dank f\u00fcr Ihre Teilnahme! Mit Klick auf den blauen Pfeil ist die Umfrage abgeschlossen. Wen..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Vielen Dank f\u00fcr Ihre Teilnahme! Mit Klick auf den blauen Pfeil ist die Umfrage abgeschlossen.</strong><br>\n<br>Wenn Sie uns zuvor noch etwas mitteilen m\u00f6chten, k\u00f6nnen Sie folgendes Kommentarfeld gerne daf\u00fcr nutzen:","DefaultChoices":false,"DataExportTag":"Kommentarfeld","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Vielen Dank f\u00fcr Ihre Teilnahme! Mit Klick auf den blauen Pfeil ist die Umfrage abgeschlossen. Wen...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID105","QuestionText_Unsafe":"<strong>Vielen Dank f&uuml;r Ihre Teilnahme!</strong><br />\n<br />\nGibt es noch etwas, das Sie uns mitteilen m&ouml;chten?"}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914402","SecondaryAttribute":"Einwilligungserkl\u00e4rung Wir bitten Sie um Ihr Einverst\u00e4ndnis zu den soeben dargestellten Teilnahme.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><u><strong>Einwilligungserkl&auml;rung</strong></u></div>\n\n<p><br />\nWir bitten Sie um Ihr Einverst&auml;ndnis zu den soeben dargestellten Teilnahmeinformationen und Informationen zum Umgang mit personenbezogenen Daten, um an der Studie teilzunehmen:</p>\n\n<p><br />\n&bdquo;Hiermit best&auml;tige ich, dass ich die Teilnahmeinformationen und die Informationen zum Umgang mit personenbezogenen Daten (Abschnitte A und B) gelesen und verstanden habe, Gelegenheit f&uuml;r R&uuml;ckfragen hatte und mit der dort beschriebenen Erhebung und Verarbeitung meiner Daten einverstanden bin. Dies schlie&szlig;t die Verarbeitung meiner Angaben zu politischen Einstellungen ausschlie&szlig;lich zu wissenschaftlichen Forschungszwecken ein.</p>\n\n<p><br />\nMeine Teilnahme ist freiwillig, und ich best&auml;tige, dass ich mindestens 18 Jahre alt bin.</p>\n\n<p><br />\nIch bin einverstanden, dass meine Antworten als Teil eines Forschungsdatensatzes ohne direkte Identifikationsdaten zu Forschungszwecken verwendet und &uuml;ber einen geregelten wissenschaftlichen Zugang (PsychArchives, Scientific Use) f&uuml;r die wissenschaftliche Nachnutzung bereitgestellt werden.</p>\n\n<p><br />\nMeine Einwilligung kann ich jederzeit mit Wirkung f&uuml;r die Zukunft widerrufen; die Grenzen einer nachtr&auml;glichen L&ouml;schung ergeben sich aus Abschnitt B (&bdquo;Auskunft, L&ouml;schung und weitere Betroffenenrechte&ldquo;).&ldquo;</p>","DefaultChoices":false,"DataExportTag":"consent","QuestionID":"QID1219914402","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Einwilligungserkl\u00e4rung Wir bitten Sie um Ihr Einverst\u00e4ndnis zu den soeben dargestellten Teilnahme...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionText_Unsafe":"<div><u><strong>Einwilligungserkl\u00e4rung</strong></u></div>\n<p>Wir bitten Sie um Ihr Einverst\u00e4ndnis zu den soeben dargestellten Teilnahmeinformationen und Informationen zum Umgang mit personenbezogenen Daten, um an der Studie teilzunehmen:</p>\n<p>\u201eHiermit best\u00e4tige ich, dass ich die Teilnahmeinformationen und die Informationen zum Umgang mit personenbezogenen Daten (Abschnitte A und B) gelesen und verstanden habe, Gelegenheit f\u00fcr R\u00fcckfragen hatte und mit der dort beschriebenen Erhebung und Verarbeitung meiner Daten einverstanden bin. Dies schlie\u00dft die Verarbeitung meiner Angaben zu politischen Einstellungen ausschlie\u00dflich zu wissenschaftlichen Forschungszwecken ein.</p>\n<p>Meine Teilnahme ist freiwillig, und ich best\u00e4tige, dass ich mindestens 18 Jahre alt bin.</p>\n<p>Ich bin einverstanden, dass meine Antworten als Teil eines Forschungsdatensatzes ohne direkte Identifikationsdaten zu Forschungszwecken verwendet und \u00fcber einen geregelten wissenschaftlichen Zugang (PsychArchives, Scientific Use) f\u00fcr die wissenschaftliche Nachnutzung bereitgestellt werden.</p>\n<p>Meine Einwilligung kann ich jederzeit mit Wirkung f\u00fcr die Zukunft widerrufen; die Grenzen einer nachtr\u00e4glichen L\u00f6schung ergeben sich aus Abschnitt B (\u201eAuskunft, L\u00f6schung und weitere Betroffenenrechte\u201c).\u201c</p>"}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914403","SecondaryAttribute":"In diesem Abschnitt geht es um politische Parteien in Deutschland. Was halten Sie von einzelnen P...","TertiaryAttribute":null,"Payload":{"QuestionText":"In diesem Abschnitt geht es um politische Parteien in Deutschland.<br />\n<br />\n<strong>Was halten Sie von einzelnen Parteien in Deutschland?</strong><br />\n<br />\n&quot;Plus 3&quot; bedeutet, dass Sie sehr viel von der Partei halten. &quot;Minus 3&quot; bedeutet, dass Sie &uuml;berhaupt nichts von der Partei halten. Mit den Werten dazwischen k&ouml;nnen Sie Ihre Meinung abstufen.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In diesem Abschnitt geht es um politische Parteien in Deutschland. Was halten Sie von einzelnen P...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"In diesem Abschnitt geht es um politische Parteien in Deutschland.<br />\n<br />\n<strong>Was halten Sie von einzelnen Parteien in Deutschland?</strong><br />\n<br />\n&quot;Plus 3&quot; bedeutet, dass Sie sehr viel von der Partei halten. &quot;Minus 3&quot; bedeutet, dass Sie &uuml;berhaupt nichts von der Partei halten. Mit den Werten dazwischen k&ouml;nnen Sie Ihre Meinung abstufen.","DataExportTag":"pol_symp_instruction","QuestionID":"QID1219914403"}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914404","SecondaryAttribute":"Was halten Sie von der SPD?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Was halten Sie von der SPD?</b>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Was halten Sie von der SPD?","Choices":{"3":{"Display":"-3 \u00fcberhaupt nichts"},"5":{"Display":"-2"},"6":{"Display":"-1"},"7":{"Display":"0"},"8":{"Display":"+1"},"9":{"Display":"+2"},"10":{"Display":"+3 sehr viel"}},"ChoiceOrder":["3","5","6","7","8","9","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":13,"NextAnswerId":1,"QuestionText_Unsafe":"Was halten Sie von der SPD?","DataExportTag":"pol_symp_spd","QuestionID":"QID1219914404","RecodeValues":{"3":"-3","5":"-2","6":"-1","7":"0","8":"1","9":"2","10":"3"}}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914405","SecondaryAttribute":"Was halten Sie von CDU/CSU?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Was halten Sie von CDU/CSU?</b>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Was halten Sie von CDU/CSU?","Choices":{"3":{"Display":"-3 \u00fcberhaupt nichts"},"5":{"Display":"-2"},"6":{"Display":"-1"},"7":{"Display":"0"},"8":{"Display":"+1"},"9":{"Display":"+2"},"10":{"Display":"+3 sehr viel"}},"ChoiceOrder":["3","5","6","7","8","9","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":13,"NextAnswerId":1,"QuestionText_Unsafe":"Was halten Sie von CDU/CSU?","DataExportTag":"pol_symp_cdu_csu","QuestionID":"QID1219914405","RecodeValues":{"3":"-3","5":"-2","6":"-1","7":"0","8":"1","9":"2","10":"3"}}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914406","SecondaryAttribute":"Was halten Sie von den Gr\u00fcnen?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Was halten Sie von den Gr\u00fcnen?</b>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Was halten Sie von den Gr\u00fcnen?","Choices":{"3":{"Display":"-3 \u00fcberhaupt nichts"},"5":{"Display":"-2"},"6":{"Display":"-1"},"7":{"Display":"0"},"8":{"Display":"+1"},"9":{"Display":"+2"},"10":{"Display":"+3 sehr viel"}},"ChoiceOrder":["3","5","6","7","8","9","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":14,"NextAnswerId":1,"QuestionText_Unsafe":"Was halten Sie von den Gr\u00fcnen?","DataExportTag":"pol_symp_greens","QuestionID":"QID1219914406","RecodeValues":{"3":"-3","5":"-2","6":"-1","7":"0","8":"1","9":"2","10":"3"}}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914407","SecondaryAttribute":"Was halten Sie von der FDP?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Was halten Sie von der FDP?</b>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Was halten Sie von der FDP?","Choices":{"3":{"Display":"-3 \u00fcberhaupt nichts"},"5":{"Display":"-2"},"6":{"Display":"-1"},"7":{"Display":"0"},"8":{"Display":"+1"},"9":{"Display":"+2"},"10":{"Display":"+3 sehr viel"}},"ChoiceOrder":["3","5","6","7","8","9","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":13,"NextAnswerId":1,"QuestionText_Unsafe":"Was halten Sie von der FDP?","DataExportTag":"pol_symp_fdp","QuestionID":"QID1219914407","RecodeValues":{"3":"-3","5":"-2","6":"-1","7":"0","8":"1","9":"2","10":"3"}}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914408","SecondaryAttribute":"Was halten Sie von der AfD?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Was halten Sie von der AfD?</b>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Was halten Sie von der AfD?","Choices":{"3":{"Display":"-3 \u00fcberhaupt nichts"},"5":{"Display":"-2"},"6":{"Display":"-1"},"7":{"Display":"0"},"8":{"Display":"+1"},"9":{"Display":"+2"},"10":{"Display":"+3 sehr viel"}},"ChoiceOrder":["3","5","6","7","8","9","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":13,"NextAnswerId":1,"QuestionText_Unsafe":"Was halten Sie von der AfD?","DataExportTag":"pol_symp_afd","QuestionID":"QID1219914408","RecodeValues":{"3":"-3","5":"-2","6":"-1","7":"0","8":"1","9":"2","10":"3"}}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914409","SecondaryAttribute":"Was halten Sie von der Linken?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Was halten Sie von der Linken?</b>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Was halten Sie von der Linken?","Choices":{"3":{"Display":"-3 \u00fcberhaupt nichts"},"5":{"Display":"-2"},"6":{"Display":"-1"},"7":{"Display":"0"},"8":{"Display":"+1"},"9":{"Display":"+2"},"10":{"Display":"+3 sehr viel"}},"ChoiceOrder":["3","5","6","7","8","9","10"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":13,"NextAnswerId":1,"QuestionText_Unsafe":"Was halten Sie von der Linken?","DataExportTag":"pol_symp_linke","QuestionID":"QID1219914409","RecodeValues":{"3":"-3","5":"-2","6":"-1","7":"0","8":"1","9":"2","10":"3"}}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914410","SecondaryAttribute":"Es folgen verschiedene Aussagen \u00fcber Traditionen, Normen und Autorit\u00e4ten. Geben Sie bei jeder Aus.","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Es folgen verschiedene Aussagen \u00fcber Traditionen, Normen und Autorit\u00e4ten. Geben Sie bei jeder Aussage an, ob Sie ihr zustimmen, nicht zustimmen, oder etwas in der Mitte zwischen beidem.</strong><br><br>Auch hierbei gibt es erneut kein \u201eRichtig\u201c oder \u201eFalsch\u201c \u2013 uns interessiert ausschlie\u00dflich Ihre pers\u00f6nliche Meinung. Bitte antworten Sie m\u00f6glichst spontan und lassen Sie keine Aussage aus.<br>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Es folgen verschiedene Aussagen \u00fcber Traditionen, Normen und Autorit\u00e4ten. Geben Sie bei jeder Aus...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Es folgen verschiedene Aussagen \u00fcber Traditionen, Normen und Autorit\u00e4ten. Geben Sie bei jeder Aussage an, ob Sie ihr zustimmen, nicht zustimmen, oder etwas in der Mitte zwischen beidem.","DataExportTag":"ASC_Instruction","QuestionID":"QID1219914410"}},{"SurveyID":"","Element":"SQ","PrimaryAttribute":"QID1219914411","SecondaryAttribute":"Wie sehr stimmen Sie dieser Aussage zu oder nicht zu? Wir sollten glauben, was unsere f\u00fchrenden P..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Wie sehr stimmen Sie dieser Aussage zu oder nicht zu?</div>\n<strong>Wir sollten glauben, was unsere f\u00fchrenden Pers\u00f6nlichkeiten sagen. </strong>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Wie sehr stimmen Sie dieser Aussage zu oder nicht zu? Wir sollten glauben, was unsere f\u00fchrenden P...","Choices":{"1":{"Display":"Stimm